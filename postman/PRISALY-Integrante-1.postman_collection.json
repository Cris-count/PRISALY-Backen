        {
          "name": "04-02 | M7-PREP-02 | Crear sesión académica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/m4/sesiones",
            "description": "Guarda sesionId. HTTP 201 no implica SMTP.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"casoId\": \"{{casoIdBruno}}\",\n  \"titulo\": \"Sesion Bruno M7\",\n  \"mensajePersonalizado\": \"Convocatoria de prueba M4-M7 (Bruno)\",\n  \"fechaInicio\": \"2030-11-10T14:00:00Z\",\n  \"fechaFin\": \"2030-11-10T16:00:00Z\",\n  \"tiempoMaximoParticipacionSegundos\": 3600\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"id\", function () { pm.expect(body.id).to.be.ok; });",
                  "pm.test(\"casoId\", function () { pm.expect(body.casoId).to.eql(pm.environment.get(\"casoIdBruno\")); });",
