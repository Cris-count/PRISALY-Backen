                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04-03 | M7-via-M4-01 | Convocar estudiante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/m4/sesiones/{{sesionId}}/convocatorias",
            "description": "201 confirma convocatoria, no SMTP. Precondición: sesionId de 04-02.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudianteId\": \"{{estudianteIdBruno}}\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"id\", function () { pm.expect(body.id).to.be.ok; });",
                  "pm.test(\"sesionId\", function () { pm.expect(body.sesionId).to.be.ok; });",
                  "pm.test(\"estudianteId\", function () { pm.expect(body.estudianteId).to.eql(pm.environment.get(\"estudianteIdBruno\")); });",
                  "if (pm.response.code === 201 && body.id) {",
                  "    pm.collectionVariables.set(\"convocatoriaId\", body.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04-04 | M7-VER-01 | Consultar convocatorias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/m4/sesiones/{{sesionId}}/convocatorias",
            "description": "Lista HTTP M4. No prueba SMTP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04-05-prep | Autenticar docente sin GESTIONAR_SESION",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/v1/personal/autenticar",
            "description": "Guarda noPermAccessToken. No sobrescribe accessToken del docente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{personnelNoPermEmail}}\",\n  \"password\": \"{{personnelNoPermPassword}}\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"accessToken\", function () { pm.expect(body.accessToken).to.be.ok; });",
                  "if (pm.response.code === 200 && body.accessToken) {",
                  "    pm.collectionVariables.set(\"noPermAccessToken\", body.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04-05 | M7-via-M4-02 | Rechazar operación sin permiso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{noPermAccessToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/m4/sesiones",
            "description": "403 M4-SIN-PERMISO. No altera sesionId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"casoId\": \"{{casoIdBruno}}\",\n  \"titulo\": \"Sesion Bruno sin GESTIONAR_SESION\",\n  \"mensajePersonalizado\": \"Debe fallar\",\n  \"fechaInicio\": \"2030-11-11T14:00:00Z\",\n  \"fechaFin\": \"2030-11-11T16:00:00Z\",\n  \"tiempoMaximoParticipacionSegundos\": 3600\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });",
                  "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"code M4-SIN-PERMISO\", function () { pm.expect(body.code).to.eql(\"M4-SIN-PERMISO\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04-06 | M7-via-M4-03 | Rechazar convocatoria sin token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/m4/sesiones/{{sesionId}}/convocatorias",
            "description": "Sin Authorization. Requiere sesionId de 04-02. Si queda {{sesionId}} literal, preparación incompleta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudianteId\": \"{{estudianteIdBruno}}\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"sesionId resuelto\", function () {",
                  "    const sid = pm.collectionVariables.get(\"sesionId\");",
                  "    pm.expect(sid, \"Ejecutar 04-02 antes; sesionId no puede estar vacío\").to.be.ok;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05-m1-finalizacion",
      "item": [
        {
