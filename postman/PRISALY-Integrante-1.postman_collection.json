{
  "info": {
    "name": "PRISALY — Integrante 1 (M1/M7)",
    "description": "Espejo de bruno/ (carpetas 00–05). Tokens en variables de colección (accessToken, noPermAccessToken, sesionId). Contraseñas solo en Current value del entorno. Orden: 00 → 05. HTTP 201 de convocatoria no implica SMTP. DD-02 deshabilitada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "noPermAccessToken",
      "value": ""
    },
    {
      "key": "sesionId",
      "value": ""
    },
    {
      "key": "convocatoriaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00-verificacion-sistema",
      "item": [
        {
          "name": "00-01 | Salud del backend | GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "PRE-00. Primera solicitud. Backend en :8080."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"service\", function () { pm.expect(body.service).to.eql(\"prisaly-backend\"); });",
                  "pm.test(\"status ok\", function () { pm.expect(body.status).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01-m1-autenticacion",
      "item": [
        {
          "name": "01-01 | M1-POST-01 | Iniciar sesión correctamente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/v1/personal/autenticar",
            "description": "Guarda accessToken en variable de colección. Password vacío → 400 (entorno).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{personnelEmail}}\",\n  \"password\": \"{{personnelPassword}}\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"accessToken\", function () { pm.expect(body.accessToken).to.be.ok; });",
                  "pm.test(\"tokenType\", function () { pm.expect(body.tokenType).to.eql(\"Bearer\"); });",
                  "pm.test(\"authPrototype\", function () { pm.expect(body.authPrototype).to.eql(\"TD-M1-AUTH-PROVISIONAL\"); });",
                  "pm.test(\"correo\", function () { pm.expect(body.correo).to.eql(pm.environment.get(\"personnelEmail\")); });",
                  "if (pm.response.code === 200 && body.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", body.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "01-02 | M1-POST-02 | Rechazar contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/v1/personal/autenticar",
            "description": "No guarda ni sobrescribe accessToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{personnelEmail}}\",\n  \"password\": \"definitely-wrong-password\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"JSON\", function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test(\"code AUTH_FAILED\", function () { pm.expect(body.code).to.eql(\"AUTH_FAILED\"); });"
                ]
              }
            }
          ]
        },
