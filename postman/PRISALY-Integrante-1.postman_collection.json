                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "05-02 | M1-VER-02 | Verificar token revocado",
          "request": {
            "method": "GET",
            "header": [
