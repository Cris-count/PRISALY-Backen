    {
      "name": "00 Preparación M1 fuera del conteo M4",
      "item": [
        {
          "name": "PRE-01 | Autenticar docente M1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/personal/autenticar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "personal",
                "autenticar"
              ]
            },
            "description": "PRE-01. Operación M1 usada solo para preparar las solicitudes M4; fuera del conteo M4. Ejecución y resultado observados: pendientes de Postman.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoDocente}}\",\n  \"password\": \"{{passwordDocente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"token devuelto\", function () { pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty; });",
                  "if (pm.response.code === 200) pm.collectionVariables.set(\"tokenDocente\", pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
