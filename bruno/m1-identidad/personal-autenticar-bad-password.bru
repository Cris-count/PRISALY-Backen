meta {
  name: personal-autenticar-bad-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/personal/autenticar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "{{personnelEmail}}",
    "password": "definitely-wrong-password"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq AUTH_FAILED
}
