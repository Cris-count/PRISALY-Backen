meta {
  name: personal-autenticar-bad-password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/personal/autenticar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "docente@prisaly.test",
    "password": "wrong-password"
  }
}

assert {
  res.status: eq 401
}
