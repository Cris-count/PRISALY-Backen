meta {
  name: personal-autenticar-unknown-user
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/personal/autenticar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "{{unknownEmail}}",
    "password": "{{personnelPassword}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq AUTH_FAILED
}
