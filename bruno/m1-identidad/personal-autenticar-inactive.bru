meta {
  name: personal-autenticar-inactive
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/personal/autenticar
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "correo": "{{inactiveEmail}}",
    "password": "{{inactivePassword}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq AUTH_FAILED
}
