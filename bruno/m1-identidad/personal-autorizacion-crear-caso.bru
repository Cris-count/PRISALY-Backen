meta {
  name: personal-autorizacion-crear-caso
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/personal/autorizacion/crear-caso
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.allowed: eq true
  res.body.permission: eq CREAR_CASO
}
