meta {
  name: 04-02 | M7-PREP-02 | Crear sesión académica
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/m4/sesiones
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "casoId": "{{casoIdBruno}}",
    "titulo": "Sesion Bruno M7",
    "mensajePersonalizado": "Convocatoria de prueba M4-M7 (Bruno)",
    "fechaInicio": "2030-11-10T14:00:00Z",
    "fechaFin": "2030-11-10T16:00:00Z",
    "tiempoMaximoParticipacionSegundos": 3600
  }
}

docs {
  M7-PREP-02. Precondiciones: 04-01; seed M7 (caso 33333333-...-3301 Publicado,
  permiso GESTIONAR_SESION). Guarda sesionId. HTTP 201 no llama a SMTP ni crea Aviso.
  Si falta el caso/permiso, no fabricar éxito: revisar seed antes de reejecutar scripts.
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.casoId: eq {{casoIdBruno}}
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setVar("sesionId", res.body.id);
  }
}
