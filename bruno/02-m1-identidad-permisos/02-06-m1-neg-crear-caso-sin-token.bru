meta {
  name: 02-06 | M1-NEG | Rechazar CREAR_CASO sin token
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/personal/autorizacion/crear-caso
  body: none
  auth: none
}

docs {
  Conserva el escenario previo personal-autorizacion-crear-caso-unauthenticated.
  Recurso protegido distinto de /me. No altera tokens.
}

assert {
  res.status: eq 401
  res.body.code: eq UNAUTHENTICATED
}
