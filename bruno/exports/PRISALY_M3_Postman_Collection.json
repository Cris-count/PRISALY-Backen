        {
          "name": "Crear borrador válido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"caseId\"); pm.environment.unset(\"caseId\");",
                  "if (!pm.variables.get(\"accessToken\")) { throw new Error(\"Falta token institucional real: accessToken\"); }",
                  "if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(pm.variables.get(\"nuevoCasoUuid\") || \"\")) { throw new Error(\"Configurar UUID explícito válido en nuevoCasoUuid\"); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP esperado: 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Sin detalles internos\", function () { pm.expect(pm.response.text()).not.to.match(/SQLSTATE|stackTrace|passwordHash|org\\.hibernate/i); });",
                  "pm.test(\"Borrador creado con UUID solicitado\", function () { pm.response.to.have.status(201); const body = pm.response.json(); pm.expect(body.estado).to.eql(\"BORRADOR\"); pm.expect(body.idCaso).to.eql(pm.variables.get(\"nuevoCasoUuid\").toLowerCase()); pm.expect(Object.keys(body).sort()).to.eql([\"estado\", \"idCaso\"]); pm.collectionVariables.set(\"caseId\", body.idCaso); pm.environment.set(\"caseId\", body.idCaso); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idCaso\": \"{{nuevoCasoUuid}}\",\n  \"titulo\": \"Borrador de prueba manual\",\n  \"tiempoEstimadoSegundos\": 300,\n  \"historia\": null,\n  \"desarrolloSituacional\": null\n}",
              "options": {
