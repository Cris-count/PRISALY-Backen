meta {
  name: Crear borrador válido
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/casos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "idCaso": "{{nuevoCasoUuid}}",
    "titulo": "Borrador de prueba manual",
    "tiempoEstimadoSegundos": 300,
    "historia": null,
    "desarrolloSituacional": null
  }
}

assert {
  res.status: eq 201
  res.body.estado: eq BORRADOR
  res.body.idCaso: isDefined
}

script:pre-request {
  if (!(bru.getVar("accessToken") || bru.getEnvVar("accessToken"))) { throw new Error("Falta token institucional real: accessToken"); }
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test((bru.getVar("nuevoCasoUuid") || bru.getEnvVar("nuevoCasoUuid")) || "")) { throw new Error("Configurar UUID explícito válido en nuevoCasoUuid"); }
}

tests {
  test("Sin detalles internos", function () {
    expect(JSON.stringify(res.body)).not.to.match(/SQLSTATE|stackTrace|passwordHash|org\.hibernate/i);
  });
  test("UUID solicitado y respuesta mínima", function () {
    expect(res.body.idCaso).to.equal((bru.getVar("nuevoCasoUuid") || bru.getEnvVar("nuevoCasoUuid")).toLowerCase());
    expect(Object.keys(res.body).sort()).to.deep.equal(["estado", "idCaso"]);
  });
}

script:post-response {
  if (res.status === 201 && res.body && res.body.estado === "BORRADOR") {
    bru.setVar("caseId", res.body.idCaso);
  }
}

docs {
  Cuenta activa M1 con CREAR_CASO. Aportar un UUID nuevo explícito. Esperado: 201 solo después de commit, idCaso y BORRADOR.
  Estado: preparada; no ejecutada. No constituye evidencia académica.
}
