meta {
  name: Crear sin permiso
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/casos
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{noPermAccessToken}}
}

body:json {
  {
    "idCaso": "{{nuevoCasoUuid}}",
    "titulo": "Borrador de prueba manual",
    "tiempoEstimadoSegundos": 300,
    "historia": null,
    "desarrolloSituacional": null
  }
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}

script:pre-request {
  if (!(bru.getVar("noPermAccessToken") || bru.getEnvVar("noPermAccessToken"))) { throw new Error("Falta token institucional real: noPermAccessToken"); }
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test((bru.getVar("nuevoCasoUuid") || bru.getEnvVar("nuevoCasoUuid")) || "")) { throw new Error("Configurar UUID explícito válido en nuevoCasoUuid"); }
}

tests {
  test("Sin detalles internos", function () {
    expect(JSON.stringify(res.body)).not.to.match(/SQLSTATE|stackTrace|passwordHash|org\.hibernate/i);
  });
}

docs {
  Token real M1 de cuenta activa sin CREAR_CASO. Un token inválido produce 401 y no satisface esta prueba. Esperado: 403.
  Estado: preparada; no ejecutada. No constituye evidencia académica.
}
