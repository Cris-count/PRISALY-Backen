# Copy to .env for local Docker Compose. Never commit real secrets.

POSTGRES_DB=prisaly
POSTGRES_USER=prisaly
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# Spring Boot (process outside Docker talking to published port)
DATABASE_URL=jdbc:postgresql://localhost:5432/prisaly?sslmode=disable
DATABASE_USER=prisaly
DATABASE_PASSWORD=change_me_local_only

APP_PORT=8080
CORS_ORIGINS=http://localhost:4200

# When the backend container is added later, use host "postgres" instead of localhost:
# DATABASE_URL=jdbc:postgresql://postgres:5432/prisaly?sslmode=disable
